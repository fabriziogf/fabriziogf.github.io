---
/**
 * A GitHub-style year calendar: one square per day, 7 rows, ~53 columns.
 *
 * Callers supply already-bucketed days (level 0-4) plus the hover title, so
 * this component owns only geometry and styling — it has no opinion about
 * what is being counted.
 */
export interface HeatmapDay {
  date: string;
  /** 0 = empty, 1-4 = increasing intensity */
  level: number;
  title: string;
}

interface Props {
  days: HeatmapDay[];
  /** CSS color for levels 1-4; level 0 always paints --hairline */
  color: string;
  ariaLabel: string;
}

const { days, color, ariaLabel } = Astro.props;

const CELL = 11;
const PITCH = CELL + 3;
// In SVG units, so it shrinks with the grid. Sized for the two-up layout,
// where the viewBox renders at roughly two-thirds scale.
const MONTH_FONT = 14;
// Baseline has to clear the type's ascender or the month row clips against the
// top of the viewBox; the grid then starts below the descender.
const MONTH_BASELINE = 12;
const TOP = MONTH_BASELINE + 6;

// The ramp starts at 0.35 so the lightest step still reads as a color against
// --hairline in both themes; anything fainter inverts on the light background.
const LEVEL_OPACITY = [0, 0.35, 0.55, 0.76, 1];

const MONTHS = ['Jan', 'Feb', 'Mar', 'Apr', 'May', 'Jun', 'Jul', 'Aug', 'Sep', 'Oct', 'Nov', 'Dec'];

const utc = (d: string) => new Date(`${d}T00:00:00Z`);

// Column 0 is the Sunday on or before the first day, so partial leading and
// trailing weeks line up on the correct weekday rows.
const origin = utc(days[0].date);
origin.setUTCDate(origin.getUTCDate() - origin.getUTCDay());

const week = (d: string) => Math.floor((utc(d).getTime() - origin.getTime()) / 604_800_000);

const cells = days.map((d) => ({ ...d, week: week(d.date), weekday: utc(d.date).getUTCDay() }));

const weeks = cells[cells.length - 1].week + 1;
const gridW = weeks * PITCH - 3;
const gridH = TOP + 7 * PITCH - 3;

// Label a month above the first column that opens in it. Keying off the
// column's own first day (rather than looking for the 1st of the month in the
// data) means the leading month still gets a label when the window starts
// mid-month, which is the common case once GitHub's window has rolled.
const firstDayOfWeek = new Map<number, string>();
for (const c of cells) {
  const held = firstDayOfWeek.get(c.week);
  if (!held || c.date < held) firstDayOfWeek.set(c.week, c.date);
}

const monthTicks: { x: number; label: string }[] = [];
let labelled = -1;
for (let w = 0; w < weeks; w++) {
  const date = firstDayOfWeek.get(w);
  if (!date) continue;
  const month = Number(date.slice(5, 7)) - 1;
  if (month === labelled) continue;
  labelled = month;
  const x = w * PITCH;
  if (x < gridW - PITCH) monthTicks.push({ x, label: MONTHS[month] });
}
---

<svg class="cal" viewBox={`0 0 ${gridW} ${gridH}`} role="img" aria-label={ariaLabel}>
  {
    monthTicks.map((t) => (
      <text class="cal-month" x={t.x} y={MONTH_BASELINE} font-size={MONTH_FONT}>
        {t.label}
      </text>
    ))
  }
  {
    cells.map((c) => (
      <rect
        x={c.week * PITCH}
        y={TOP + c.weekday * PITCH}
        width={CELL}
        height={CELL}
        rx="2"
        fill={c.level === 0 ? 'var(--hairline)' : color}
        fill-opacity={c.level === 0 ? 1 : LEVEL_OPACITY[c.level]}
      >
        <title>{c.title}</title>
      </rect>
    ))
  }
</svg>

<div
  class="cal-foot"
  style={`--swatch: ${((CELL / gridW) * 100).toFixed(3)}; --label: ${((MONTH_FONT / gridW) * 100).toFixed(3)}`}
>
  <slot />
  <p class="cal-legend">
    <span>Less</span>
    {
      LEVEL_OPACITY.map((o, i) => (
        <i style={`background: ${i === 0 ? 'var(--hairline)' : color}; opacity: ${i === 0 ? 1 : o}`} />
      ))
    }
    <span>More</span>
  </p>
</div>

<style>
  .cal-foot {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 16px;
    margin-top: 14px;
    /* query container so the legend can size against the grid width, not
       against its own flex row */
    container-type: inline-size;
  }

  .cal {
    display: block;
    width: 100%;
    height: auto;
  }

  .cal rect {
    transition: fill-opacity 0.15s ease;
  }

  .cal rect:hover {
    fill-opacity: 1;
  }

  /* size comes from the MONTH_FONT attribute, in SVG units */
  .cal-month {
    font-family: var(--mono);
    fill: var(--faint);
  }

  .cal-legend {
    display: flex;
    align-items: center;
    gap: 3px;
    font-family: var(--mono);
    /* --label mirrors the month row, so both labels render at the same size */
    font-size: calc(var(--label) * 1cqw);
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--faint);
    margin: 0;
  }

  /* --swatch is the cell's share of the grid width, so the legend squares
     stay the same size as the grid's own squares at any viewport. */
  .cal-legend i {
    width: calc(var(--swatch) * 1cqw);
    aspect-ratio: 1;
    border-radius: 1.5px;
    flex: none;
  }

  .cal-legend span:first-child {
    margin-right: 3px;
  }

  .cal-legend span:last-child {
    margin-left: 3px;
  }
</style>
