---
import '@fontsource-variable/inter-tight';
import '@fontsource/ibm-plex-mono/400.css';
import '@fontsource/ibm-plex-mono/500.css';
import '../styles/global.css';

interface Props {
  title?: string;
  description?: string;
  /** slug of the card under /og/, minus the .png — see src/pages/og/ */
  ogSlug?: string;
}

const { title, description = "Fabrizio GF's personal website", ogSlug = 'site' } = Astro.props;
const pageTitle = title ? `${title} - fabriziogf.github.io` : 'fabriziogf.github.io';

// Absolute URLs: social clients don't resolve relative paths.
const canonical = new URL(Astro.url.pathname, Astro.site);
const ogImage = new URL(`/og/${ogSlug}.png`, Astro.site);

const navItems = [
  { label: 'Writing', href: '/year-archive/' },
  { label: 'Projects', href: '/projects/' },
  { label: 'Training', href: '/training/' },
  { label: 'About', href: '/about/' },
];

const current = Astro.url.pathname.replace(/\/+$/, '') + '/';
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical.href} />

    <meta property="og:type" content={ogSlug === 'site' ? 'website' : 'article'} />
    <meta property="og:site_name" content="fabriziogf.github.io" />
    <meta property="og:title" content={title ?? 'Fabrizio GF'} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical.href} />
    <meta property="og:image" content={ogImage.href} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title ?? 'Fabrizio GF'} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage.href} />

    <link rel="alternate" type="application/rss+xml" title="Fabrizio GF" href="/feed.xml" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
  </head>
  <body>
    <header class="site-header">
      <div class="container">
        <a class="site-logo" href="/" aria-label="Fabrizio GF — home">
          <svg class="logo-mark" viewBox="0 3 32 26" aria-hidden="true">
            <path
              d="M6.5 19.5 L16 12.5 L25.5 5.5"
              fill="none"
              stroke="var(--ink)"
              stroke-width="1.4"
              stroke-linecap="round"
              stroke-linejoin="round"
              opacity="0.3"></path>
            <circle cx="6.5" cy="26.5" r="2.5" fill="var(--ink)" opacity="0.95"></circle>
            <circle cx="6.5" cy="19.5" r="2.5" fill="var(--ink)" opacity="0.7"></circle>
            <circle cx="16" cy="26.5" r="2.5" fill="var(--ink)" opacity="0.95"></circle>
            <circle cx="16" cy="19.5" r="2.5" fill="var(--ink)" opacity="0.7"></circle>
            <circle cx="16" cy="12.5" r="2.5" fill="var(--ink)" opacity="0.5"></circle>
            <circle cx="25.5" cy="26.5" r="2.5" fill="var(--ink)" opacity="0.95"></circle>
            <circle cx="25.5" cy="19.5" r="2.5" fill="var(--ink)" opacity="0.7"></circle>
            <circle cx="25.5" cy="12.5" r="2.5" fill="var(--ink)" opacity="0.5"></circle>
            <circle cx="25.5" cy="5.5" r="2.5" fill="var(--ink)" opacity="0.34"></circle>
          </svg>
          <span>Fabrizio GF</span>
        </a>
        <nav class="site-nav" aria-label="Main">
          {
            navItems.map((item) => (
              <a href={item.href} aria-current={current === item.href ? 'page' : undefined}>
                {item.label}
              </a>
            ))
          }
        </nav>
      </div>
    </header>

    <main>
      <slot />
    </main>

    <footer class="site-footer">
      <div class="container">
        <span>© {new Date().getFullYear()} Fabrizio Giovannini Filho</span>
        <span>
          <a href="https://github.com/fabriziogf" rel="noopener">GitHub</a>
          &nbsp;·&nbsp;
          <a href="https://www.linkedin.com/in/fgiovanninifilho/" rel="noopener">LinkedIn</a>
          &nbsp;·&nbsp;
          <a href="https://www.strava.com/athletes/25618422" rel="noopener">Strava</a>
          &nbsp;·&nbsp;
          <a href="mailto:fabriziogf@gmail.com">Email</a>
          &nbsp;·&nbsp;
          <a href="/feed.xml">RSS</a>
        </span>
      </div>
    </footer>
  </body>
</html>
