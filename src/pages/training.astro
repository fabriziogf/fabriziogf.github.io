  }

  .data-table td {
    padding: 8px 12px 8px 0;
    border-bottom: 1px solid var(--hairline);
    vertical-align: baseline;
  }

  .data-table .r {
    text-align: right;
  }

  .data-table th.r {
    padding-right: 0;
  }

  .data-table td.r {
    padding-right: 0;
    white-space: nowrap;
  }

  .mono-cell {
    font-family: var(--mono);
    font-size: 12.5px;
    color: var(--muted);
    white-space: nowrap;
  }

  .sport-chip {
    display: inline-flex;
    align-items: center;
    gap: 7px;
    font-weight: 600;
    font-size: 13px;
    white-space: nowrap;
  }

  .sport-chip i {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    flex: none;
  }

  .session-link {
    text-decoration: none;
    border-bottom: 1px dotted var(--faint);
  }

  .session-link:hover {
    border-bottom-style: solid;
    border-bottom-color: var(--ink);
  }

  .heatmap td,
  .heatmap th {
    padding-left: 10px;
  }

  /* ── PRs ── */
  .segment {
    display: inline-flex;
    border: 1px solid var(--rule);
    border-radius: 4px;
    overflow: hidden;
    margin-top: 32px;
  }

  .seg-btn {
    appearance: none;
    background: none;
    border: none;
    padding: 8px 18px;
    font-family: var(--mono);
