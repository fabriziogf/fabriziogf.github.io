    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--muted);
    cursor: pointer;
  }

  .seg-btn + .seg-btn {
    border-left: 1px solid var(--rule);
  }

  .seg-btn[aria-pressed='true'] {
