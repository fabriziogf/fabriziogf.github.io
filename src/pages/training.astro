---
import Base from '../layouts/Base.astro';
import { loadTrainingData, SPORT_COLORS, SPORT_LABELS, type SportKey } from '../lib/training';
// Inlined at build time by Vite. Do NOT switch these to readFileSync with a path
// built from import.meta.url — in a production build that resolves inside dist/,
// not the source tree, and the build fails with ENOENT.
import libContent from '../../docs/workout-library.md?raw';
import yonkersMd from './yonkers-plan.md?raw';

const td = loadTrainingData();
const sports = ['swim', 'bike', 'run', 'strength'] as const;

const totalTss = sports.reduce((a, s) => a + td.totals[s].tss, 0);
const totalHours = sports.reduce((a, s) => a + td.totals[s].hours, 0);

const sportVar = (s: SportKey) => `var(--${s})`;
const sportInkVar = (s: SportKey) => `var(--${s}-ink)`;

// Heatmap intensities (rendered at build time)
const monthly = td.monthly ?? [];
const monthTotals = monthly.map((m) => sports.reduce((a, s) => a + m[s].tss, 0));
const maxMonthTss = Math.max(...monthTotals, 1);
function shortMonth(ym: string): string {
  const [y, m] = ym.split('-');
  return new Date(Number(y), Number(m) - 1).toLocaleDateString('en-US', {
    month: 'short',
    year: '2-digit',
  });
}

// PR tables
const bikeOrder = ['power5sec', 'power1min', 'power5min', 'power10min', 'power20min', 'power60min'];
const runOrder = ['speed1K', 'speed5K', 'speed10K', 'speedHalfMarathon', 'speedMarathon'];

type PrRow = { label: string; value: string; date: string; workout: string };
function prRows(
  group: Record<string, any>,
  order: string[],
  period: 'this_year' | 'all_time',
  fmt: (v: any) => string
): PrRow[] {
  return order
    .filter((k) => group?.[k])
    .map((k) => {
      const e = group[k];
      const v = e[period];
      return {
        label: e.label,
        value: v != null && v !== '' ? fmt(v) : '—',
        date: e[`${period}_date`] ?? '',
        workout: e[`${period}_workout`] ?? '',
      };
    });
}
const fmtWatts = (v: any) => `${Math.round(Number(v))} W`;
const fmtPace = (v: any) => `${v}/km`;

const prTables = [
  {
    sport: 'bike' as const,
    heading: 'Bike — Peak Power',
    col: 'Duration',
    periods: {
      this_year: prRows(td.prs?.bike ?? {}, bikeOrder, 'this_year', fmtWatts),
      all_time: prRows(td.prs?.bike ?? {}, bikeOrder, 'all_time', fmtWatts),
    },
  },
  {
    sport: 'run' as const,
    heading: 'Run — Pace',
    col: 'Distance',
    periods: {
      this_year: prRows(td.prs?.run ?? {}, runOrder, 'this_year', fmtPace),
      all_time: prRows(td.prs?.run ?? {}, runOrder, 'all_time', fmtPace),
    },
  },
];

// Parse workout library from markdown
type LibWorkout = {
  type: string;
  typeKey: string;
  phase: string;
  raceCtx: string;
  date: string;
  volume: string;
  tss: string;
  title: string;
  wu: string;
  ms: string;
  cd: string;
  sport: 'swim' | 'bike' | 'run';
};

// Swim zones run A1→A3, bike/run run Z2→Z5; A2 sits at race pace and A3 at
// threshold, so the same "Threshold" prefix means different things per sport.
function getTypeKey(type: string, sport: 'swim' | 'bike' | 'run'): string {
  if (sport === 'swim') {
    if (type.startsWith('Threshold')) return 'racepace';
    if (type.startsWith('Speed')) return 'threshold';
    return 'base';
  }
  if (type.startsWith('VO2max')) return 'vo2max';
  if (type.startsWith('Threshold')) return 'threshold';
  if (type.startsWith('Race-pace')) return 'racepace';
  return 'base';
}

function parseLibSection(content: string, heading: string, sport: 'swim' | 'bike' | 'run'): LibWorkout[] {
  const regex = new RegExp(`## ${heading}\\n([\\s\\S]*?)(?=\\n## |$)`);
  const m = content.match(regex);
  if (!m) return [];
  const rows = m[1].split('\n').filter((l) => {
    const t = l.trim();
    return t.startsWith('|') && !t.includes('---') && !l.includes('| Type |') && !l.includes('| # |');
  });
  return rows.map((line) => {
    const cells = line.split('|').map((c) => c.trim()).filter(Boolean);
    if (cells.length < 8) return null;
    const desc = cells[cells.length - 1] ?? '';
    const titleMatch = desc.match(/\*\*(.+?)\.\*\*/);
    const wuMatch = desc.match(/WU:\s*(.+?)(?=\s*MS:|$)/);
    const msMatch = desc.match(/MS:\s*(.+?)(?=\s*CD:|$)/);
    const cdMatch = desc.match(/CD:\s*(.+?)$/);
    const volume = sport === 'bike'
      ? `${cells[7] ?? ''} · ${cells[6] ?? ''}`
      : (cells[6] ?? '');
    return {
      type: cells[1] ?? '',
      typeKey: getTypeKey(cells[1] ?? '', sport),
      phase: cells[2] ?? '',
      raceCtx: cells[3] ?? '',
      date: cells[5] ?? '',
      volume,
      tss: cells[8] ?? '',
      title: titleMatch?.[1] ?? '',
      wu: wuMatch?.[1]?.trim() ?? '',
      ms: msMatch?.[1]?.trim() ?? '',
      cd: cdMatch?.[1]?.trim() ?? '',
      sport,
    };
  }).filter((x): x is LibWorkout => x !== null);
}

const swimLib = parseLibSection(libContent, 'Swimming', 'swim');
const bikeLib = parseLibSection(libContent, 'Cycling', 'bike');
const runLib = parseLibSection(libContent, 'Running', 'run');
const allLib = [...swimLib, ...bikeLib, ...runLib];

// ── Training plans ────────────────────────────────────────────────────────
// Parsed from the plan page itself so the dashboard can't drift out of sync.
function parsePlanWeeks(md: string) {
  const heads = [...md.matchAll(/^## Week (\d+) — (.+)$/gm)].map((m) => {
    const parts = m[2].split('·').map((s) => s.trim());
    return {
      week: Number(m[1]),
      focus: (parts[1] ?? '').replace(/\s*\(.+?\)\s*$/, '').trim(),
    };
  });

  const tbl = md.match(/## Volume summary\s*\n([\s\S]*?)(?=\n## |$)/);
  const rows = tbl
    ? tbl[1].split('\n').filter((l) => {
        const t = l.trim();
        return t.startsWith('|') && !t.includes('---') && !l.includes('| Week |');
      })
    : [];

  return rows.map((line, i) => {
    const c = line
      .split('|')
      .map((s) => s.trim().replace(/\*\*/g, ''))
      .filter(Boolean);
    return {
      week: heads[i]?.week ?? i + 1,
      focus: heads[i]?.focus ?? '',
      dates: c[0] ?? '',
      run: c[1] ?? '',
      bike: c[2] ?? '',
      swim: c[3] ?? '',
      lift: c[4] ?? '',
      long: c[5] ?? '',
    };
  });
}

const planWeeks = parsePlanWeeks(yonkersMd);

const raceDate = new Date(2026, 8, 20); // Sunday, Sep 20 2026
const now = new Date();
const midnight = new Date(now.getFullYear(), now.getMonth(), now.getDate());
const daysOut = Math.round((raceDate.getTime() - midnight.getTime()) / 86_400_000);

const plans = [
  {
    href: '/yonkers-plan/',
    name: 'Training Plan',
    blurb:
      'Six-week build — three build weeks, one sharpening week, two taper weeks. Every session, both weekend options, and pace targets.',
    meta: '4:15–4:25/km target · peak 67 km/week',
  },
  {
    href: '/yonkers-lifting/',
    name: 'Lifting Plan',
    blurb:
      'Strength work sequenced against the post-Ironman back program. Two sessions a week plus a daily ten-minute reset.',
    meta: '3 phases · 2 sessions/week',
  },
];

// Payload for the client-side charts
const chartData = {
  daily: td.daily,
  monthly: td.monthly,
  ctlTrend: td.ctl_trend,
  totals: Object.fromEntries(sports.map((s) => [s, td.totals[s].tss])),
  colors: SPORT_COLORS,
};
---

<Base title="Training Dashboard" ogSlug="training">
  <div class="container">
    <header class="page-head">
      <p class="micro-label"><span class="dot" style="background: var(--strava)"></span>Training</p>
      <h1 class="page-title">Training Dashboard</h1>
      <p class="window num">
        Rolling 7-day window <strong>{td.window_start}</strong> → <strong>{td.window_end}</strong>
        &nbsp;·&nbsp; Updated {td.generated_at}
      </p>
      <p class="strava-link">
        <a href="https://www.strava.com/athletes/25618422" target="_blank" rel="noopener">
          View my profile on Strava →
        </a>
      </p>
    </header>

    <div class="tabs" role="tablist" aria-label="Dashboard views">
      <button class="tab" role="tab" id="tab-btn-week" aria-selected="true" aria-controls="tab-week">This Week</button>
      <button class="tab" role="tab" id="tab-btn-trends" aria-selected="false" aria-controls="tab-trends">12-Month Trends</button>
      <button class="tab" role="tab" id="tab-btn-prs" aria-selected="false" aria-controls="tab-prs">Personal Records</button>
      <button class="tab" role="tab" id="tab-btn-library" aria-selected="false" aria-controls="tab-library">Workout Library</button>
      <button class="tab" role="tab" id="tab-btn-plans" aria-selected="false" aria-controls="tab-plans">Training Plans</button>
    </div>

    <!-- ── TAB 1 · THIS WEEK ─────────────────────────────────── -->
    <section id="tab-week" role="tabpanel" aria-labelledby="tab-btn-week">
      <h2 class="sec">Fitness (PMC)</h2>
      <div class="stat-row num">
        <div class="stat">
          <p class="micro-label"><span class="dot" style="background: var(--swim)"></span>Fitness · CTL</p>
          <b>{td.fitness.ctl.toFixed(1)}</b>
        </div>
        <div class="stat">
          <p class="micro-label"><span class="dot" style="background: var(--fatigue)"></span>Fatigue · ATL</p>
          <b>{td.fitness.atl.toFixed(1)}</b>
        </div>
        <div class="stat">
          <p class="micro-label">
            <span class="dot" style={`background: ${td.fitness.tsb >= 0 ? 'var(--bike)' : 'var(--fatigue)'}`}></span>
            Form · TSB
          </p>
          <b>{td.fitness.tsb >= 0 ? `+${td.fitness.tsb.toFixed(1)}` : td.fitness.tsb.toFixed(1)}</b>
        </div>
      </div>

      <h2 class="sec">7-Day Summary</h2>
      <div class="sport-row num">
        {
          sports.map((s) => (
            <div class="sport-cell">
              <p class="micro-label">
                <span class="dot" style={`background: ${sportVar(s)}`} />
                {SPORT_LABELS[s]}
              </p>
              <div class="sport-line"><span>Sessions</span><strong>{td.totals[s].sessions}</strong></div>
              <div class="sport-line"><span>Hours</span><strong>{td.totals[s].hours}h</strong></div>
              {s !== 'strength' && (
                <div class="sport-line"><span>Distance</span><strong>{td.totals[s].distance_km} km</strong></div>
              )}
              <div class="sport-line"><span>TSS</span><strong>{td.totals[s].tss}</strong></div>
            </div>
          ))
        }
      </div>
      <p class="totals-line num">
        <strong>Total TSS</strong> {totalTss} &nbsp;·&nbsp; <strong>Total Hours</strong> {totalHours.toFixed(1)}h
      </p>

      <h2 class="sec">Daily TSS by Sport</h2>
      <div class="chart-box"><canvas id="chartDailyTSS"></canvas></div>

      <h2 class="sec">Daily Hours by Sport</h2>
      <div class="chart-box"><canvas id="chartDailyHours"></canvas></div>

      <h2 class="sec">TSS Distribution</h2>
      <div class="chart-box donut"><canvas id="chartTSSDonut"></canvas></div>

      <h2 class="sec">Sessions This Week</h2>
      <div class="table-scroll">
        <table class="data-table num">
          <thead>
            <tr>
              <th>Date</th>
              <th>Sport</th>
              <th>Session</th>
              <th class="r">Hours</th>
              <th class="r">Distance</th>
              <th class="r">TSS</th>
              <th class="r">Avg HR</th>
              <th class="r">Avg Power</th>
            </tr>
          </thead>
          <tbody>
            {
              td.workouts.map((w) => (
                <tr>
                  <td class="mono-cell">{w.date}</td>
                  <td>
                    <span class="sport-chip" style={`color: ${sportInkVar(w.sport)}`}>
                      <i style={`background: ${sportVar(w.sport)}`} />
                      {SPORT_LABELS[w.sport]}
                    </span>
                  </td>
                  <td>
                    {w.strava_id ? (
                      <a class="session-link" href={`https://www.strava.com/activities/${w.strava_id}`} target="_blank" rel="noopener">
                        {w.title}
                      </a>
                    ) : (
                      w.title
                    )}
                  </td>
                  <td class="r">{w.hours}h</td>
                  <td class="r">{w.distance_km > 0 ? `${w.distance_km} km` : '—'}</td>
                  <td class="r">{w.tss}</td>
                  <td class="r">{w.hr_avg ? `${w.hr_avg} bpm` : '—'}</td>
                  <td class="r">{w.power_avg ? `${w.power_avg} W` : '—'}</td>
                </tr>
              ))
            }
          </tbody>
        </table>
      </div>
    </section>

    <!-- ── TAB 2 · 12-MONTH TRENDS ───────────────────────────── -->
    <section id="tab-trends" role="tabpanel" aria-labelledby="tab-btn-trends" hidden>
      <h2 class="sec">Monthly TSS by Sport</h2>
      <div class="chart-box tall"><canvas id="chartMonthlyTSS"></canvas></div>

      <h2 class="sec">Monthly Hours by Sport</h2>
      <div class="chart-box tall"><canvas id="chartMonthlyHours"></canvas></div>

      <h2 class="sec">CTL / ATL Trend</h2>
      <p class="sec-note">End-of-day values, one per calendar day over the past 12 months.</p>
      <div class="chart-box"><canvas id="chartCTL"></canvas></div>

      <h2 class="sec">Monthly Volume Heatmap</h2>
      <div class="table-scroll">
        <table class="data-table num heatmap">
          <thead>
            <tr>
              <th>Month</th>
              {sports.map((s) => (
                <th class="r" style={`color: ${sportInkVar(s)}`}>{SPORT_LABELS[s]}</th>
              ))}
              <th class="r">Total TSS</th>
            </tr>
          </thead>
          <tbody>
            {
              monthly.map((m, i) => (
                <tr style={`background: rgba(79, 195, 247, ${((monthTotals[i] / maxMonthTss) * 0.28).toFixed(2)})`}>
                  <td class="mono-cell"><strong>{shortMonth(m.month)}</strong></td>
                  {sports.map((s) => (
                    <td class="r">{m[s].tss > 0 ? m[s].tss : '—'}</td>
                  ))}
                  <td class="r"><strong>{monthTotals[i]}</strong></td>
                </tr>
              ))
            }
          </tbody>
        </table>
      </div>
    </section>

    <!-- ── TAB 3 · PERSONAL RECORDS ──────────────────────────── -->
    <section id="tab-prs" role="tabpanel" aria-labelledby="tab-btn-prs" hidden>
      <div class="segment" role="group" aria-label="Record period">
        <button class="seg-btn" data-period="this_year" aria-pressed="true">2026 · This Year</button>
        <button class="seg-btn" data-period="all_time" aria-pressed="false">All-Time</button>
      </div>

      {
        prTables.map((t) => (
          <div class="pr-block">
            <p class="micro-label">
              <span class="dot" style={`background: ${sportVar(t.sport)}`} />
              {t.heading}
            </p>
            {(['this_year', 'all_time'] as const).map((period) => (
              <div class="table-scroll pr-period" data-period={period} hidden={period === 'all_time'}>
                <table class="data-table num">
                  <thead>
                    <tr>
                      <th>{t.col}</th>
                      <th>{period === 'this_year' ? '2026 Best' : 'All-Time Best'}</th>
                      <th>Date</th>
                      <th>Session</th>
                    </tr>
                  </thead>
                  <tbody>
                    {t.periods[period].map((row) => (
                      <tr>
                        <td>{row.label}</td>
                        <td class="pr-value">{row.value}</td>
                        <td class="mono-cell">{row.date}</td>
                        <td class="pr-workout">{row.workout}</td>
                      </tr>
                    ))}
                  </tbody>
                </table>
              </div>
            ))}
          </div>
        ))
      }
    </section>

    <!-- ── TAB 4 · WORKOUT LIBRARY ──────────────────────────── -->
    <section id="tab-library" role="tabpanel" aria-labelledby="tab-btn-library" hidden>
      <h2 class="sec">Workout Library</h2>
      <p class="lib-lead">30 curated sessions per discipline, sorted by ascending intensity then duration.</p>

      <div class="lib-filters">
        <div class="lib-filter-row">
          <span class="lib-filter-label">Sport</span>
          <div class="lib-filter-group" role="group" aria-label="Filter by sport">
            <button class="lib-sport-btn" data-lib-sport="all" aria-pressed="true">All</button>
            <button class="lib-sport-btn" data-lib-sport="swim" aria-pressed="false">Swim</button>
            <button class="lib-sport-btn" data-lib-sport="bike" aria-pressed="false">Bike</button>
            <button class="lib-sport-btn" data-lib-sport="run" aria-pressed="false">Run</button>
          </div>
        </div>
        <div class="lib-filter-row">
          <span class="lib-filter-label">Type</span>
          <div class="lib-filter-group" role="group" aria-label="Filter by intensity">
            <button class="lib-type-btn" data-lib-type="all" aria-pressed="true">All</button>
            <button class="lib-type-btn" data-lib-type="base" aria-pressed="false">Base</button>
            <button class="lib-type-btn" data-lib-type="racepace" aria-pressed="false">Race-pace</button>
            <button class="lib-type-btn" data-lib-type="threshold" aria-pressed="false">Threshold</button>
            <button class="lib-type-btn" data-lib-type="vo2max" aria-pressed="false">VO2max</button>
          </div>
        </div>
        <div class="lib-filter-row">
          <span class="lib-filter-label">Phase</span>
          <div class="lib-filter-group" role="group" aria-label="Filter by training phase">
            <button class="lib-phase-btn" data-lib-phase="all" aria-pressed="true">All</button>
            <button class="lib-phase-btn" data-lib-phase="Base" aria-pressed="false">Base</button>
            <button class="lib-phase-btn" data-lib-phase="Build" aria-pressed="false">Build</button>
            <button class="lib-phase-btn" data-lib-phase="Sharpening" aria-pressed="false">Sharpening</button>
            <button class="lib-phase-btn" data-lib-phase="Race taper" aria-pressed="false">Race taper</button>
          </div>
        </div>
      </div>

      <div class="table-scroll">
        <table class="data-table lib-table">
          <thead>
            <tr>
              <th>Sport</th>
              <th>Type</th>
              <th class="lib-phase-cell">Phase</th>
              <th class="lib-date-cell">Date</th>
              <th class="lib-vol-cell">Volume</th>
              <th class="lib-tss-cell">TSS</th>
              <th>Session</th>
            </tr>
          </thead>
          <tbody>
            {allLib.map((w) => (
              <tr class="lib-row" data-sport={w.sport} data-type={w.typeKey} data-phase={w.phase}>
                <td><span class={`sport-chip sport-chip--${w.sport}`}>{w.sport}</span></td>
                <td><span class={`type-chip type-chip--${w.typeKey}`}>{w.type}</span></td>
                <td class="lib-phase-cell">{w.phase}</td>
                <td class="mono-cell lib-date-cell">{w.date}</td>
                <td class="mono-cell lib-vol-cell">{w.volume}</td>
                <td class="mono-cell lib-tss-cell">{w.tss}</td>
                <td class="lib-session">
                  {w.title && <div class="lib-title">{w.title}</div>}
                  {w.wu && <div class="lib-interval"><span class="ikey">WU</span>{w.wu}</div>}
                  {w.ms && <div class="lib-interval lib-ms-line"><span class="ikey">MS</span>{w.ms}</div>}
                  {w.cd && <div class="lib-interval"><span class="ikey">CD</span>{w.cd}</div>}
                </td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
    </section>

    <!-- ── TAB 5 · TRAINING PLANS ───────────────────────────── -->
    <section id="tab-plans" role="tabpanel" aria-labelledby="tab-btn-plans" hidden>
      <h2 class="sec">Yonkers Marathon</h2>
      <div class="stat-row num">
        <div class="stat">
          <p class="micro-label"><span class="dot" style="background: var(--run)"></span>Race day</p>
          <b>Sep 20</b>
        </div>
        <div class="stat">
          <p class="micro-label">{daysOut >= 0 ? 'Days out' : 'Days since'}</p>
          <b>{Math.abs(daysOut)}</b>
        </div>
        <div class="stat">
          <p class="micro-label">Target pace</p>
          <b>4:15–4:25</b>
        </div>
      </div>

      <h2 class="sec">Plans</h2>
      <div class="plan-cards">
        {
          plans.map((p) => (
            <a class="plan-card" href={p.href}>
              <span class="plan-name">{p.name} <i class="plan-arrow">→</i></span>
              <span class="plan-blurb">{p.blurb}</span>
              <span class="plan-meta num">{p.meta}</span>
            </a>
          ))
        }
      </div>

      <h2 class="sec">Week by Week</h2>
      <div class="table-scroll">
        <table class="data-table num">
          <thead>
            <tr>
              <th>Week</th>
              <th>Dates</th>
              <th>Focus</th>
              <th>Run</th>
              <th>Bike</th>
              <th>Swim</th>
              <th>Lift</th>
              <th>Long run</th>
            </tr>
          </thead>
          <tbody>
            {
              planWeeks.map((w) => (
                <tr>
                  <td class="mono-cell">{w.week}</td>
                  <td class="mono-cell plan-dates">{w.dates}</td>
                  <td>{w.focus && <span class="plan-focus">{w.focus}</span>}</td>
                  <td class="mono-cell">{w.run}</td>
                  <td class="mono-cell">{w.bike}</td>
                  <td class="mono-cell">{w.swim}</td>
                  <td class="mono-cell">{w.lift}</td>
                  <td class="mono-cell plan-long">{w.long}</td>
                </tr>
              ))
            }
          </tbody>
        </table>
      </div>
      <p class="plan-note">
        Read from <a href="/yonkers-plan/">the training plan</a> at build time — the numbers here and there
        can't disagree.
      </p>
    </section>
  </div>

  <script type="application/json" id="td-data" set:html={JSON.stringify(chartData)} />
</Base>

<script>
  import Chart from 'chart.js/auto';

  const data = JSON.parse(document.getElementById('td-data')!.textContent!);
  const sports = ['swim', 'bike', 'run', 'strength'] as const;
  const label = (s: string) => s.charAt(0).toUpperCase() + s.slice(1);

  // ── Theme-aware chart defaults ────────────────────────────
  const css = () => getComputedStyle(document.documentElement);
  function applyTheme() {
    Chart.defaults.color = css().getPropertyValue('--muted').trim();
    Chart.defaults.borderColor = css().getPropertyValue('--hairline').trim();
    Chart.defaults.font.family = getComputedStyle(document.body).getPropertyValue('--mono');
    Chart.defaults.font.size = 11;
  }
  applyTheme();

  const charts: Chart[] = [];
  matchMedia('(prefers-color-scheme: dark)').addEventListener('change', () => {
    applyTheme();
    for (const c of charts) {
      c.options.color = Chart.defaults.color;
      for (const scale of Object.values(c.options.scales ?? {})) {
        if (scale && 'grid' in scale) (scale as any).grid.color = Chart.defaults.borderColor;
        if (scale && 'ticks' in scale) (scale as any).ticks.color = Chart.defaults.color;
      }
      c.update();
    }
  });

  const stacked = {
    responsive: true,
    maintainAspectRatio: false,
    plugins: { legend: { position: 'bottom' as const } },
    scales: {
      x: { stacked: true, grid: { display: false } },
      y: { stacked: true, beginAtZero: true },
    },
  };

  function shortMonth(ym: string) {
    const [y, m] = ym.split('-');
    return new Date(+y, +m - 1).toLocaleDateString('en-US', { month: 'short', year: '2-digit' });
  }

  const dayLabels = data.daily.map((d: any) =>
    new Date(d.date + 'T00:00:00').toLocaleDateString('en-US', {
      weekday: 'short',
      month: 'short',
      day: 'numeric',
    })
  );

  const barSets = (rows: any[], field: string) =>
    sports.map((s) => ({
      label: label(s),
      data: rows.map((r: any) => r[s][field]),
      backgroundColor: data.colors[s],
    }));

  // Charts are created lazily per tab: Chart.js laid out inside a hidden
  // panel gets zero dimensions, so each tab builds its charts on first view.
  function createWeekCharts() {
  charts.push(
    new Chart(document.getElementById('chartDailyTSS') as HTMLCanvasElement, {
      type: 'bar',
      data: { labels: dayLabels, datasets: barSets(data.daily, 'tss') },
      options: {
        ...stacked,
        plugins: {
          ...stacked.plugins,
          tooltip: {
            callbacks: {
              footer: (items: any[]) => `Total TSS: ${items.reduce((a, i) => a + i.raw, 0).toFixed(0)}`,
            },
          },
        },
      },
    })
  );

  charts.push(
    new Chart(document.getElementById('chartDailyHours') as HTMLCanvasElement, {
      type: 'bar',
      data: { labels: dayLabels, datasets: barSets(data.daily, 'hours') },
      options: {
        ...stacked,
        plugins: {
          ...stacked.plugins,
          tooltip: {
            callbacks: {
              label: (ctx: any) => ` ${ctx.dataset.label}: ${ctx.raw}h`,
              footer: (items: any[]) => `Total: ${items.reduce((a, i) => a + i.raw, 0).toFixed(1)}h`,
            },
          },
        },
        scales: {
          ...stacked.scales,
          y: { stacked: true, beginAtZero: true, ticks: { callback: (v: any) => v + 'h' } },
        },
      },
    })
  );

  // Chart 3: donut
  charts.push(
    new Chart(document.getElementById('chartTSSDonut') as HTMLCanvasElement, {
      type: 'doughnut',
      data: {
        labels: sports.map(label),
        datasets: [
          {
            data: sports.map((s) => data.totals[s]),
            backgroundColor: sports.map((s) => data.colors[s]),
            borderWidth: 0,
            hoverOffset: 8,
          },
        ],
      },
      options: {
        responsive: true,
        maintainAspectRatio: false,
        plugins: {
          legend: { position: 'bottom' },
          tooltip: {
            callbacks: {
              label: (ctx: any) => {
                const total = ctx.dataset.data.reduce((a: number, v: number) => a + v, 0);
                const pct = total > 0 ? ((ctx.raw / total) * 100).toFixed(0) : 0;
                return ` ${ctx.label}: ${ctx.raw} TSS (${pct}%)`;
              },
            },
          },
        },
      },
    })
  );
  }

  // Charts 4 + 5: monthly TSS / hours
  function createTrendsCharts() {
  const monthLabels = data.monthly.map((m: any) => shortMonth(m.month));

  charts.push(
    new Chart(document.getElementById('chartMonthlyTSS') as HTMLCanvasElement, {
      type: 'bar',
      data: { labels: monthLabels, datasets: barSets(data.monthly, 'tss') },
      options: {
        ...stacked,
        plugins: {
          ...stacked.plugins,
          tooltip: {
            callbacks: {
              footer: (items: any[]) => `Total: ${items.reduce((a, i) => a + i.raw, 0).toFixed(0)} TSS`,
            },
          },
        },
      },
    })
  );

  charts.push(
    new Chart(document.getElementById('chartMonthlyHours') as HTMLCanvasElement, {
      type: 'bar',
      data: { labels: monthLabels, datasets: barSets(data.monthly, 'hours') },
      options: {
        ...stacked,
        plugins: {
          ...stacked.plugins,
          tooltip: {
            callbacks: {
              label: (ctx: any) => ` ${ctx.dataset.label}: ${ctx.raw}h`,
              footer: (items: any[]) => `Total: ${items.reduce((a, i) => a + i.raw, 0).toFixed(1)}h`,
            },
          },
        },
        scales: {
          ...stacked.scales,
          y: { stacked: true, beginAtZero: true, ticks: { callback: (v: any) => v + 'h' } },
        },
      },
    })
  );

  // Chart 6: CTL/ATL trend, sampled weekly to stay readable
  const trend = data.ctlTrend.filter(
    (_: any, i: number) => i % 7 === 0 || i === data.ctlTrend.length - 1
  );
  charts.push(
    new Chart(document.getElementById('chartCTL') as HTMLCanvasElement, {
      type: 'line',
      data: {
        labels: trend.map((c: any) =>
          new Date(c.month + '-01T00:00:00').toLocaleDateString('en-US', {
            month: 'short',
            day: 'numeric',
          })
        ),
        datasets: [
          {
            label: 'CTL (Fitness)',
            data: trend.map((c: any) => c.ctl),
            borderColor: data.colors.swim,
            backgroundColor: 'rgba(79, 195, 247, 0.08)',
            tension: 0.3,
            fill: true,
            pointRadius: 0,
            borderWidth: 2,
          },
          {
            label: 'ATL (Fatigue)',
            data: trend.map((c: any) => c.atl),
            borderColor: '#ef9a9a',
            tension: 0.3,
            fill: false,
            pointRadius: 0,
            borderWidth: 1.5,
          },
        ],
      },
      options: {
        responsive: true,
        maintainAspectRatio: false,
        interaction: { mode: 'index', intersect: false },
        plugins: {
          legend: { position: 'bottom' },
          tooltip: {
            callbacks: {
              afterBody: (items: any[]) => {
                const ctl = items[0]?.raw ?? 0;
                const atl = items[1]?.raw ?? 0;
                return `TSB (Form): ${(ctl - atl).toFixed(1)}`;
              },
            },
          },
        },
        scales: { x: { grid: { display: false } }, y: { beginAtZero: false } },
      },
    })
  );
  }

  createWeekCharts();

  // ── Tabs ──────────────────────────────────────────────────
  let trendsChartsBuilt = false;
  const tabs = document.querySelectorAll<HTMLButtonElement>('.tab');
  tabs.forEach((btn) => {
    btn.addEventListener('click', () => {
      tabs.forEach((b) => b.setAttribute('aria-selected', String(b === btn)));
      document.querySelectorAll<HTMLElement>('[role="tabpanel"]').forEach((p) => {
        p.hidden = p.id !== btn.getAttribute('aria-controls');
      });
      if (btn.id === 'tab-btn-trends' && !trendsChartsBuilt) {
        trendsChartsBuilt = true;
        createTrendsCharts();
      }
      window.dispatchEvent(new Event('resize')); // repaint after unhiding
    });
  });

  // ── PR period toggle ──────────────────────────────────────
  document.querySelectorAll<HTMLButtonElement>('.seg-btn').forEach((btn) => {
    btn.addEventListener('click', () => {
      const period = btn.dataset.period;
      document
        .querySelectorAll<HTMLButtonElement>('.seg-btn')
        .forEach((b) => b.setAttribute('aria-pressed', String(b === btn)));
      document.querySelectorAll<HTMLElement>('.pr-period').forEach((div) => {
        div.hidden = div.dataset.period !== period;
      });
    });
  });

  // ── Workout library filters ───────────────────────────────
  let libSport = 'all';
  let libType = 'all';
  let libPhase = 'all';

  function applyLibFilter() {
    document.querySelectorAll<HTMLElement>('.lib-row').forEach((row) => {
      const matchSport = libSport === 'all' || row.dataset.sport === libSport;
      const matchType = libType === 'all' || row.dataset.type === libType;
      const matchPhase = libPhase === 'all' || row.dataset.phase === libPhase;
      row.hidden = !(matchSport && matchType && matchPhase);
    });
  }

  document.querySelectorAll<HTMLButtonElement>('.lib-sport-btn').forEach((btn) => {
    btn.addEventListener('click', () => {
      libSport = btn.dataset.libSport ?? 'all';
      document.querySelectorAll<HTMLButtonElement>('.lib-sport-btn')
        .forEach((b) => b.setAttribute('aria-pressed', String(b === btn)));
      applyLibFilter();
    });
  });

  document.querySelectorAll<HTMLButtonElement>('.lib-type-btn').forEach((btn) => {
    btn.addEventListener('click', () => {
      libType = btn.dataset.libType ?? 'all';
      document.querySelectorAll<HTMLButtonElement>('.lib-type-btn')
        .forEach((b) => b.setAttribute('aria-pressed', String(b === btn)));
      applyLibFilter();
    });
  });

  document.querySelectorAll<HTMLButtonElement>('.lib-phase-btn').forEach((btn) => {
    btn.addEventListener('click', () => {
      libPhase = btn.dataset.libPhase ?? 'all';
      document.querySelectorAll<HTMLButtonElement>('.lib-phase-btn')
        .forEach((b) => b.setAttribute('aria-pressed', String(b === btn)));
      applyLibFilter();
    });
  });
</script>

<style>
  .window {
    font-family: var(--mono);
