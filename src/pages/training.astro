  .type-chip--threshold { background: color-mix(in srgb, #ce93d8 18%, transparent); color: #7b1fa2; }
  .type-chip--vo2max    { background: color-mix(in srgb, #ef9a9a 20%, transparent); color: #c62828; }

  /* Session cell */
  .lib-session {
