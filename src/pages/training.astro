    font-family: var(--mono);
    font-size: 11px;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--muted);
    cursor: pointer;
  }

  .lib-sport-btn + .lib-sport-btn,
  .lib-type-btn + .lib-type-btn,
  .lib-phase-btn + .lib-phase-btn {
    border-left: 1px solid var(--rule);
  }

  .lib-sport-btn[aria-pressed='true'],
  .lib-type-btn[aria-pressed='true'],
  .lib-phase-btn[aria-pressed='true'] {
    background: var(--ink);
    color: var(--bg);
