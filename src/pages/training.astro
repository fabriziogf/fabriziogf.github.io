  /* ── Charts ── */
  .chart-box {
    position: relative;
    height: 300px;
  }

  .chart-box.tall {
    height: 340px;
  }

  .chart-box.donut {
    height: 320px;
    max-width: 420px;
    margin: 0 auto;
  }

  /* ── Tables ── */
  .data-table {
    width: 100%;
    border-collapse: collapse;
    font-size: 14px;
  }

  .data-table th {
    font-family: var(--mono);
