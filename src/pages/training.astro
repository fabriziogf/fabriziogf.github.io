  }

  @media (max-width: 760px) {
    .stat-row {
      grid-template-columns: 1fr;
    }

    .stat,
    .sport-cell {
      border-right: none;
      border-bottom: 1px solid var(--hairline);
      padding-left: 0;
    }

    .stat:last-child,
    .sport-cell:last-child {
      border-bottom: none;
    }
  }

  /* ── Workout Library tab ── */
  .lib-lead {
    font-size: 13.5px;
    color: var(--muted);
    margin: 0 0 24px;
  }

  .lib-filters {
    display: flex;
    flex-direction: column;
    gap: 8px;
    margin-bottom: 24px;
  }

  .lib-filter-row {
    display: flex;
    align-items: center;
    gap: 12px;
  }

  .lib-filter-label {
    font-family: var(--mono);
    font-size: 10.5px;
    letter-spacing: 0.08em;
    text-transform: uppercase;
