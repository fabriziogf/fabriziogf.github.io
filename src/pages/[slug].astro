---
import { render } from 'astro:content';
import Base from '../layouts/Base.astro';
import { sortedPosts, parseId, formatDate, isoDate, seriesFor } from '../lib/posts';

export async function getStaticPaths() {
  const posts = await sortedPosts();
  return posts.map((post) => ({
    params: { slug: parseId(post.id).slug },
    props: { post },
  }));
}

const { post } = Astro.props;
const { date, slug } = parseId(post.id);
const { Content } = await render(post);
const series = await seriesFor(post);

// Posts carry only a title, so the social/search description comes from the
// opening prose: first non-heading, non-HTML paragraph, stripped of markdown.
const summary = post.body
  ?.split('\n\n')
  .map((block) => block.trim())
  .find((block) => block && !/^[#<\-*>|]/.test(block))
  ?.replace(/\[([^\]]+)\]\([^)]*\)/g, '$1') // links → their text
  .replace(/[*_`]/g, '')
  .replace(/\s+/g, ' ')
  .trim();

const description =
  summary && summary.length > 160 ? `${summary.slice(0, 157).trimEnd()}…` : summary;
---

<Base title={post.data.title} description={description} ogSlug={slug}>
  <div class="container">
    <article>
      <header class="post-head">
        <p class="micro-label">
          <span class="dot" style="background: var(--ink)"></span>
        Writing
        </p>
        <h1 class="page-title">{post.data.title}</h1>
        <p class="post-meta num">
          <time datetime={isoDate(date)}>{formatDate(date)}</time>
          {series?.counter && (
            <>
              &nbsp;·&nbsp;<span class="series-count">{series.counter}</span>
            </>
          )}
        </p>
      </header>

      {
        series && (series.previous || series.next) && (
          <nav class="series-jump" aria-label={`${series.name}: nearby posts`}>
            {series.previous ? (
              <a class="arrow-link" href={`/${series.previous.slug}/`}>
                ← {series.previous.navLabel}
              </a>
            ) : (
              <span />
            )}
            {series.next && (
              <a class="arrow-link" href={`/${series.next.slug}/`}>
                {series.next.navLabel} →
              </a>
            )}
          </nav>
        )
      }

      <div class="prose">
        <Content />
      </div>

      {
        series?.showIndex && (
          <nav class="series" aria-label={`${series.name} series`}>
            <p class="micro-label">
              <span class="dot" style="background: var(--swim)" />
              {series.name}
            </p>
            <ol class="series-list num">
              {series.parts.map((p, i) => (
                <li class:list={['series-item', { here: p.current }]}>
                  <span class="series-num">{String(i + 1).padStart(2, '0')}</span>
                  {p.current ? (
                    <span aria-current="page">{p.label}</span>
                  ) : (
                    <a href={`/${p.slug}/`}>{p.label}</a>
                  )}
                </li>
              ))}
            </ol>
          </nav>
        )
      }

      <nav class="post-foot">
        <a class="arrow-link" href="/year-archive/">← All posts</a>
      </nav>
    </article>
  </div>
</Base>

<style>
  .post-head {
    padding: 44px 0 28px;
    border-bottom: 1px solid var(--rule);
    margin-bottom: 36px;
  }

  .post-meta {
    font-family: var(--mono);
    font-size: 12.5px;
    color: var(--muted);
    margin: 16px 0 0;
  }

  .series-count {
    color: var(--swim-ink);
  }

  /* sits between the header rule and the article body */
  .series-jump {
    display: flex;
    justify-content: space-between;
    gap: 16px;
    margin: -20px 0 32px;
  }

  .series {
    margin-top: 56px;
    padding-top: 24px;
    border-top: 1px solid var(--rule);
  }

  .series-list {
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .series-item {
    display: flex;
    gap: 14px;
    align-items: baseline;
    padding: 8px 0;
    border-bottom: 1px solid var(--hairline);
    font-size: 14.5px;
  }

  .series-item:last-child {
    border-bottom: none;
  }

  .series-num {
    font-family: var(--mono);
    font-size: 11.5px;
    color: var(--faint);
    flex: none;
  }

  .series-item a {
    text-decoration: none;
  }

  .series-item a:hover {
    text-decoration: underline;
    text-decoration-color: var(--faint);
    text-underline-offset: 3px;
  }

  /* the part you're on: marked, not linked */
  .series-item.here {
    font-weight: 650;
  }

  .series-item.here .series-num {
    color: var(--swim-ink);
  }

  .post-foot {
    display: flex;
    justify-content: space-between;
    gap: 16px;
    margin-top: 40px;
    padding-top: 20px;
    border-top: 1px solid var(--hairline);
  }
</style>
