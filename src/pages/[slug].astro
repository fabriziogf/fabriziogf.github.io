---
import { render } from 'astro:content';
import Base from '../layouts/Base.astro';
import { sortedPosts, parseId, formatDate, isoDate } from '../lib/posts';

export async function getStaticPaths() {
  const posts = await sortedPosts();
  return posts.map((post) => ({
    params: { slug: parseId(post.id).slug },
    props: { post },
  }));
}

const { post } = Astro.props;
const { date, slug } = parseId(post.id);
const { Content } = await render(post);

// Posts carry only a title, so the social/search description comes from the
// opening prose: first non-heading, non-HTML paragraph, stripped of markdown.
const summary = post.body
  ?.split('\n\n')
  .map((block) => block.trim())
  .find((block) => block && !/^[#<\-*>|]/.test(block))
  ?.replace(/\[([^\]]+)\]\([^)]*\)/g, '$1') // links → their text
  .replace(/[*_`]/g, '')
  .replace(/\s+/g, ' ')
  .trim();

const description =
  summary && summary.length > 160 ? `${summary.slice(0, 157).trimEnd()}…` : summary;
---

<Base title={post.data.title} description={description} ogSlug={slug}>
  <div class="container">
    <article>
      <header class="post-head">
        <p class="micro-label">
          <span class="dot" style="background: var(--ink)"></span>
        Writing
        </p>
        <h1 class="page-title">{post.data.title}</h1>
        <p class="post-meta num">
          <time datetime={isoDate(date)}>{formatDate(date)}</time>
        </p>
      </header>
      <div class="prose">
        <Content />
      </div>
      <nav class="post-foot">
        <a class="arrow-link" href="/year-archive/">← All posts</a>
      </nav>
    </article>
  </div>
</Base>

<style>
  .post-head {
    padding: 44px 0 28px;
    border-bottom: 1px solid var(--rule);
    margin-bottom: 36px;
  }

  .post-meta {
    font-family: var(--mono);
    font-size: 12.5px;
    color: var(--muted);
    margin: 16px 0 0;
  }

  .post-foot {
    margin-top: 56px;
    padding-top: 20px;
    border-top: 1px solid var(--hairline);
  }
</style>
