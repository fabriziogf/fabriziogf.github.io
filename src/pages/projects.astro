---
import Base from '../layouts/Base.astro';
import { projects } from '../lib/projects';
---

<Base title="Side Projects" ogSlug="projects">
  <div class="container">
    <header class="page-head">
      <p class="micro-label"><span class="dot" style="background: var(--bike)"></span>Projects</p>
      <h1 class="page-title">Side Projects</h1>
      <p class="gh-link">
        <a href="https://github.com/fabriziogf" target="_blank" rel="noopener">
          View all my code on GitHub →
        </a>
      </p>
      <p class="sub">
        The <strong>live outputs</strong> of projects I’m actively building — tools, models,
        dashboards, and experiments. Each card links directly to the finished artifact. I work
        across AI/ML, GenAI tooling, sports analytics, and decision systems; projects here range
        from polished prototypes to early releases.
      </p>
    </header>

    <div class="grid">
      {
        projects.map((p) => (
          <article class="card">
            <div class="card-head">
              <p class="micro-label" style="margin: 0">
                <span class="dot" style={`background: ${p.dot}`} />
                <span style={`color: ${p.tagColor}`}>{p.tag}</span>
              </p>
              <span class:list={['status', { wip: p.status !== 'Active' }]}>{p.status}</span>
            </div>
            <h2 class="card-title">{p.title}</h2>
            <p class="card-desc">{p.desc}</p>
            <p class="card-stack">{p.stack}</p>
            <div class="card-links">
              {p.links.map((l) => (
                <a
                  class="arrow-link"
                  href={l.href}
                  target={l.external ? '_blank' : undefined}
                  rel={l.external ? 'noopener' : undefined}
                >
                  {l.label}
                </a>
              ))}
            </div>
          </article>
        ))
      }
    </div>
  </div>
</Base>

<style>
  .grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(290px, 1fr));
    border-left: 1px solid var(--hairline);
    border-top: 1px solid var(--hairline);
    margin-top: 0;
  }

  .card {
    display: flex;
    flex-direction: column;
    gap: 10px;
    padding: 26px 28px 28px;
    border-right: 1px solid var(--hairline);
    border-bottom: 1px solid var(--hairline);
  }

  .card-head {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 12px;
  }

  .status {
    font-family: var(--mono);
    font-size: 10.5px;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--bike-ink);
    border: 1px solid currentColor;
    border-radius: 99px;
    padding: 2px 10px;
    white-space: nowrap;
  }

  .status.wip {
    color: var(--wip);
  }

  .card-title {
    font-size: 19px;
    font-weight: 650;
    letter-spacing: -0.01em;
    line-height: 1.25;
    margin: 2px 0 0;
  }

  .card-desc {
    font-size: 14px;
    line-height: 1.6;
    color: var(--muted);
    margin: 0;
    flex-grow: 1;
  }

  .card-stack {
    font-family: var(--mono);
    font-size: 11.5px;
    color: var(--faint);
    margin: 0;
  }

  .card-links {
    display: flex;
    gap: 20px;
    flex-wrap: wrap;
    margin-top: 4px;
  }

  .gh-link {
    margin: 14px 0 0;
  }

  .gh-link a {
    font-size: 13px;
    font-weight: 600;
    text-decoration: none;
    border-bottom: 1px solid var(--hairline);
    padding-bottom: 1px;
  }

  .gh-link a:hover {
    border-bottom-color: var(--ink);
  }

</style>
