---
import Base from '../layouts/Base.astro';
import { sortedPosts, parseId, formatDate } from '../lib/posts';
import { loadTrainingData } from '../lib/training';
import { loadContributions } from '../lib/github';
import CalendarHeatmap from '../components/CalendarHeatmap.astro';

const posts = (await sortedPosts()).slice(0, 4);
const td = loadTrainingData();
const contrib = await loadContributions('fabriziogf');

const contribDays = (contrib?.days ?? []).map((d) => ({
  date: d.date,
  level: d.level,
  title: `${d.count === 0 ? 'No' : d.count} contribution${d.count === 1 ? '' : 's'} on ${d.date}`,
}));

// Training calendar — same grid, bucketed by daily moving time. Thresholds are
// fixed rather than relative so a light month reads as light: roughly a short
// session, an hour-plus, a long ride or brick, then the big weekend days.
const HOUR_STEPS = [1.5, 3, 4.5];
const trainingDays = (td.year_daily ?? []).map((d) => ({
  date: d.date,
  level: d.hours === 0 ? 0 : HOUR_STEPS.filter((t) => d.hours >= t).length + 1,
  title:
    d.hours === 0
      ? `Rest day on ${d.date}`
      : `${d.hours.toFixed(1)}h on ${d.date}${d.sports ? ` — ${d.sports.split(',').join(', ')}` : ''}`,
}));
const trainingHours = (td.year_daily ?? []).reduce((a, d) => a + d.hours, 0);
---

<Base>
  <div class="container">
    <section class="hero">
      <div class="hero-text">
        <h1>Welcome to my personal website!</h1>
        <p>
          I’m <a href="/about/">Fabrizio</a>: product leader, builder, and endurance sports
          enthusiast. I created this site as a place to share what I’m learning and what I’m
          building.
        </p>
        <p>
          Expect posts on AI, ML, data science, product thinking, sports, and the occasional side
          project.
        </p>
      </div>
      <figure class="hero-photo">
        <img src="/assets/images/family_pic.jpg" alt="Fabrizio, Emily, and Ralphie" width="640" />
      </figure>
    </section>

    <section class="cal-grid">
      {
        contrib && (
          <div class="cal-block">
            <div class="cal-head">
              <p class="micro-label">
                <span class="dot" style="background: var(--github)" />
                GitHub Contributions
              </p>
              <p class="cal-total">
                <b class="num">{contrib.total.toLocaleString()}</b> in the last year
              </p>
            </div>

            <CalendarHeatmap
              days={contribDays}
              color="var(--github)"
              ariaLabel={`GitHub contribution calendar: ${contrib.total} contributions between ${contrib.start} and ${contrib.end}`}
            >
              <a class="arrow-link" href="https://github.com/fabriziogf" target="_blank" rel="noopener">
                View my GitHub →
              </a>
            </CalendarHeatmap>
          </div>
        )
      }

      {
        trainingDays.length > 0 && (
          <div class="cal-block">
            <div class="cal-head">
              <p class="micro-label">
                <span class="dot" style="background: var(--strava)" />
                Workout Hours
              </p>
              <p class="cal-total">
                <b class="num">{Math.round(trainingHours).toLocaleString()}h</b> in the last year
              </p>
            </div>

            <CalendarHeatmap
              days={trainingDays}
              color="var(--strava)"
              ariaLabel={`Training calendar: ${Math.round(trainingHours)} hours of swim, bike, run, and strength work between ${trainingDays[0].date} and ${trainingDays[trainingDays.length - 1].date}`}
            >
              <a class="arrow-link" href="/training/">View dashboard →</a>
            </CalendarHeatmap>
          </div>
        )
      }
    </section>

    <section class="cells">
      <div class="cell">
        <p class="micro-label"><span class="dot" style="background: var(--ink)"></span>Latest writing</p>
        {
          posts.map((post) => {
            const { date, slug } = parseId(post.id);
            return (
              <a class="post-item" href={`/${slug}/`}>
                <span class="post-date num">{formatDate(date)}</span>
                <span class="post-title">{post.data.title}</span>
              </a>
            );
          })
        }
        <a class="arrow-link cell-more" href="/year-archive/">All posts →</a>
      </div>

      <div class="cell">
        <p class="micro-label"><span class="dot" style="background: var(--swim)"></span>Now building</p>
        <a class="post-item" href="/projects/">
          <span class="post-title">Fantasy Football Draft Assistant</span>
          <span class="post-sub">Value-based pick recommendations, live on the clock</span>
        </a>
        <a class="post-item" href="/projects/">
          <span class="post-title">World Cup 2026 Prediction Model</span>
          <span class="post-sub">Monte Carlo tournament simulator on Dixon-Coles and Elo</span>
        </a>
        <a class="post-item" href="/projects/">
          <span class="post-title">Job Hunting Agent</span>
          <span class="post-sub">An AI agent that runs a full job search end-to-end</span>
        </a>
        <a class="post-item" href="/training/">
          <span class="post-title">Training Dashboard</span>
          <span class="post-sub">Live Strava + TrainingPeaks pipeline, updated daily</span>
        </a>
        <a class="arrow-link cell-more" href="/projects/">All projects →</a>
      </div>
    </section>

  </div>
</Base>

<style>
  .hero {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    gap: 36px;
    align-items: center;
    padding: 52px 0 44px;
    border-bottom: 1px solid var(--rule);
  }

  .hero h1 {
    font-size: clamp(28px, 3.8vw, 38px);
    font-weight: 650;
    letter-spacing: -0.03em;
    line-height: 1.08;
    margin: 0 0 20px;
    text-wrap: balance;
  }

  .hero-text p {
    margin: 0 0 0.9em;
    color: var(--muted);
    max-width: 72ch;
  }

  .hero-text p:last-child {
    margin-bottom: 0;
  }

  .hero-text a {
    color: var(--ink);
    text-decoration: underline;
    text-decoration-color: var(--faint);
    text-underline-offset: 3px;
  }

  .hero-photo {
    margin: 0;
  }

  .hero-photo img {
    display: block;
    width: 285px;
    max-width: 100%;
    border-radius: 4px;
    border: 1px solid var(--hairline);
  }

  .cells {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    border-bottom: 1px solid var(--hairline);
  }

  .cell {
    padding: 28px 28px 30px;
    border-right: 1px solid var(--hairline);
    display: flex;
    flex-direction: column;
  }

  .cell:first-child {
    padding-left: 0;
  }

  .cell:last-child {
    border-right: none;
    padding-right: 0;
  }

  .post-item {
    display: block;
    text-decoration: none;
    padding: 9px 0;
    border-bottom: 1px solid var(--hairline);
  }

  .post-item:last-of-type {
    border-bottom: none;
  }

  .post-date {
    display: block;
    font-family: var(--mono);
    font-size: 11px;
    color: var(--faint);
    margin-bottom: 2px;
  }

  .post-title {
    display: block;
    font-size: 14.5px;
    font-weight: 600;
    line-height: 1.35;
  }

  .post-item:hover .post-title {
    text-decoration: underline;
    text-decoration-color: var(--faint);
    text-underline-offset: 3px;
  }

  /* Matches .post-date, so items in both cells come out the same height */
  .post-sub {
    display: block;
    font-size: 11px;
    color: var(--muted);
    margin-top: 2px;
  }

  .cell-more {
    margin-top: auto;
    padding-top: 18px;
    align-self: flex-start;
  }

  /* Same two-up rhythm as .cells, so the calendars read as another row of
     the same grid rather than a separate block. */
  .cal-grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    border-bottom: 1px solid var(--hairline);
  }

  .cal-block {
    padding: 28px 28px 30px;
    border-right: 1px solid var(--hairline);
  }

  .cal-block:first-child {
    padding-left: 0;
  }

  .cal-block:last-child {
    border-right: none;
    padding-right: 0;
  }

  .cal-head {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    gap: 12px;
    flex-wrap: wrap;
    margin-bottom: 16px;
  }

  .cal-head .micro-label {
    margin: 0;
  }

  .cal-total {
    font-size: 13px;
    color: var(--muted);
    margin: 0;
  }

  .cal-total b {
    font-size: 15px;
    font-weight: 700;
    color: var(--ink);
  }

  @media (max-width: 860px) {
    .hero {
      grid-template-columns: 1fr;
      gap: 28px;
      padding: 40px 0 36px;
    }

    .cells,
    .cal-grid {
      grid-template-columns: 1fr;
    }

    .cell,
    .cal-block {
      border-right: none;
      border-bottom: 1px solid var(--hairline);
      padding-left: 0;
      padding-right: 0;
    }

    .cell:last-child,
    .cal-block:last-child {
      border-bottom: none;
    }
  }
</style>
