---
import Base from '../layouts/Base.astro';
import { sortedPosts, parseId, formatDate } from '../lib/posts';
import { loadTrainingData } from '../lib/training';
import { loadContributions } from '../lib/github';

const posts = (await sortedPosts()).slice(0, 4);
const td = loadTrainingData();
const contrib = await loadContributions('fabriziogf');

// Contribution grid geometry, in SVG units — the whole thing scales to fit
const CELL = 11;
const PITCH = CELL + 3;
const TOP = 16; // room for the month row above the grid
// index 0 is unused — empty days paint --hairline instead. The ramp starts at
// 0.35 so the lightest green still reads as green against --hairline in both
// light and dark mode; anything fainter inverts against the light background.
const LEVEL_OPACITY = [0, 0.35, 0.55, 0.76, 1];
const gridW = (contrib?.weeks ?? 0) * PITCH - 3;
const gridH = TOP + 7 * PITCH - 3;

const MONTHS = ['Jan', 'Feb', 'Mar', 'Apr', 'May', 'Jun', 'Jul', 'Aug', 'Sep', 'Oct', 'Nov', 'Dec'];

// Label each month above its first full week; the leading partial month is
// skipped for free, since its 1st falls outside the window.
const monthTicks = (contrib?.days ?? [])
  .filter((d) => d.date.endsWith('-01'))
  .map((d) => ({
    x: (d.weekday === 0 ? d.week : d.week + 1) * PITCH,
    label: MONTHS[Number(d.date.slice(5, 7)) - 1],
  }))
  .filter((t) => t.x < gridW - PITCH);

const dayLabel = (d: { count: number; date: string }) =>
  `${d.count === 0 ? 'No' : d.count} contribution${d.count === 1 ? '' : 's'} on ${d.date}`;

const weekHours = (['swim', 'bike', 'run', 'strength'] as const).reduce(
  (a, s) => a + td.totals[s].hours,
  0
);

// CTL sparkline from the 12-month trend, thinned to keep the polyline light
const trend = td.ctl_trend ?? [];
const step = Math.max(1, Math.floor(trend.length / 40));
const pts = trend.filter((_, i) => i % step === 0 || i === trend.length - 1);
const ctlMin = Math.min(...pts.map((p) => p.ctl));
const ctlMax = Math.max(...pts.map((p) => p.ctl));
const W = 260;
const H = 44;
const sparkPoints = pts
  .map((p, i) => {
    const x = (i / (pts.length - 1)) * W;
    const y = H - 4 - ((p.ctl - ctlMin) / (ctlMax - ctlMin || 1)) * (H - 8);
    return `${x.toFixed(1)},${y.toFixed(1)}`;
  })
  .join(' ');
const lastPoint = sparkPoints.split(' ').at(-1)!.split(',');
---

<Base>
  <div class="container">
    <section class="hero">
      <div class="hero-text">
        <h1>Welcome to my personal website!</h1>
        <p>
          I’m <a href="/about/">Fabrizio</a>: product leader, builder, and endurance sports
          enthusiast. I created this site as a place to share what I’m learning and what I’m
          building.
        </p>
        <p>
          Expect posts on AI, ML, data science, product thinking, sports, and the occasional side
          project.
        </p>
      </div>
      <figure class="hero-photo">
        <img src="/assets/images/family_pic.jpg" alt="Fabrizio, Emily, and Ralphie" width="640" />
      </figure>
    </section>

    <section class="cells">
      <div class="cell">
        <p class="micro-label"><span class="dot" style="background: var(--ink)"></span>Latest writing</p>
        {
          posts.map((post) => {
            const { date, slug } = parseId(post.id);
            return (
              <a class="post-item" href={`/${slug}/`}>
                <span class="post-date num">{formatDate(date)}</span>
                <span class="post-title">{post.data.title}</span>
              </a>
            );
          })
        }
        <a class="arrow-link cell-more" href="/year-archive/">All posts →</a>
      </div>

      <div class="cell">
        <p class="micro-label"><span class="dot" style="background: var(--bike)"></span>Now building</p>
        <a class="post-item" href="/projects/">
          <span class="post-title">Fantasy Football Draft Assistant</span>
          <span class="post-sub">Value-based pick recommendations, live on the clock</span>
        </a>
        <a class="post-item" href="/projects/">
          <span class="post-title">World Cup 2026 Prediction Model</span>
          <span class="post-sub">Monte Carlo tournament simulator on Dixon-Coles and Elo</span>
        </a>
        <a class="post-item" href="/projects/">
          <span class="post-title">Job Hunting Agent</span>
          <span class="post-sub">An AI agent that runs a full job search end-to-end</span>
        </a>
        <a class="post-item" href="/training/">
          <span class="post-title">Training Dashboard</span>
          <span class="post-sub">Live Strava + TrainingPeaks pipeline, updated daily</span>
        </a>
        <a class="arrow-link cell-more" href="/projects/">All projects →</a>
      </div>

      <div class="cell">
        <p class="micro-label"><span class="dot" style="background: var(--run)"></span>Training</p>
        <div class="metrics num">
          <div><b>{td.fitness.ctl.toFixed(1)}</b><span>CTL</span></div>
          <div><b>{td.fitness.tsb >= 0 ? `+${td.fitness.tsb.toFixed(1)}` : td.fitness.tsb.toFixed(1)}</b><span>TSB</span></div>
          <div><b>{weekHours.toFixed(1)}h</b><span>Week</span></div>
        </div>
        <svg
          class="spark"
          viewBox={`0 0 ${W} ${H}`}
          preserveAspectRatio="none"
          role="img"
          aria-label={`Chronic training load over the past 12 months, currently ${td.fitness.ctl}`}
        >
          <polyline points={sparkPoints} fill="none" stroke="var(--run)" stroke-width="2"></polyline>
          <circle cx={lastPoint[0]} cy={lastPoint[1]} r="3.4" fill="var(--ink)"></circle>
        </svg>
        <p class="spark-cap">CTL, trailing 12 months → Ironman Lake Placid, July 19</p>
        <a class="arrow-link cell-more" href="/training/">View dashboard →</a>
      </div>
    </section>

    {
      contrib && (
        <section class="contrib">
          <div class="contrib-head">
            <p class="micro-label">
              <span class="dot" style="background: var(--bike)" />
              GitHub Contributions
            </p>
            <p class="contrib-total">
              <b class="num">{contrib.total.toLocaleString()}</b> in the last year
            </p>
          </div>

          <svg
            class="contrib-grid"
            viewBox={`0 0 ${gridW} ${gridH}`}
            role="img"
            aria-label={`GitHub contribution calendar: ${contrib.total} contributions between ${contrib.start} and ${contrib.end}`}
          >
            {monthTicks.map((t) => (
              <text class="contrib-month" x={t.x} y="9">
                {t.label}
              </text>
            ))}
            {contrib.days.map((d) => (
              <rect
                x={d.week * PITCH}
                y={TOP + d.weekday * PITCH}
                width={CELL}
                height={CELL}
                rx="2"
                fill={d.level === 0 ? 'var(--hairline)' : 'var(--bike)'}
                fill-opacity={d.level === 0 ? 1 : LEVEL_OPACITY[d.level]}
              >
                <title>{dayLabel(d)}</title>
              </rect>
            ))}
          </svg>

          <div class="contrib-foot">
            <a class="arrow-link" href="https://github.com/fabriziogf" target="_blank" rel="noopener">
              View my GitHub →
            </a>
            <p class="contrib-legend">
              <span>Less</span>
              {LEVEL_OPACITY.map((o, i) => (
                <i style={`background: ${i === 0 ? 'var(--hairline)' : 'var(--bike)'}; opacity: ${i === 0 ? 1 : o}`} />
              ))}
              <span>More</span>
            </p>
          </div>
        </section>
      )
    }
  </div>
</Base>

<style>
  .hero {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    gap: 48px;
    align-items: center;
    padding: 52px 0 44px;
    border-bottom: 1px solid var(--rule);
  }

  .hero h1 {
    font-size: clamp(32px, 4.5vw, 46px);
    font-weight: 650;
    letter-spacing: -0.03em;
    line-height: 1.08;
    margin: 0 0 20px;
    text-wrap: balance;
  }

  .hero-text p {
    margin: 0 0 0.9em;
    color: var(--muted);
    max-width: 56ch;
  }

  .hero-text p:last-child {
    margin-bottom: 0;
  }

  .hero-text a {
    color: var(--ink);
    text-decoration: underline;
    text-decoration-color: var(--faint);
    text-underline-offset: 3px;
  }

  .hero-photo {
    margin: 0;
  }

  .hero-photo img {
    display: block;
    width: 300px;
    max-width: 100%;
    border-radius: 4px;
    border: 1px solid var(--hairline);
  }

  .cells {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    border-bottom: 1px solid var(--hairline);
  }

  .cell {
    padding: 28px 28px 30px;
    border-right: 1px solid var(--hairline);
    display: flex;
    flex-direction: column;
  }

  .cell:first-child {
    padding-left: 0;
  }

  .cell:last-child {
    border-right: none;
    padding-right: 0;
  }

  .post-item {
    display: block;
    text-decoration: none;
    padding: 9px 0;
    border-bottom: 1px solid var(--hairline);
  }

  .post-item:last-of-type {
    border-bottom: none;
  }

  .post-date {
    display: block;
    font-family: var(--mono);
    font-size: 11px;
    color: var(--faint);
    margin-bottom: 2px;
  }

  .post-title {
    display: block;
    font-size: 14.5px;
    font-weight: 600;
    line-height: 1.35;
  }

  .post-item:hover .post-title {
    text-decoration: underline;
    text-decoration-color: var(--faint);
    text-underline-offset: 3px;
  }

  .post-sub {
    display: block;
    font-size: 12.5px;
    color: var(--muted);
    margin-top: 2px;
  }

  .cell-more {
    margin-top: auto;
    padding-top: 18px;
    align-self: flex-start;
  }

  .metrics {
    display: flex;
    gap: 26px;
    margin: 4px 0 16px;
  }

  .metrics b {
    display: block;
    font-size: 27px;
    font-weight: 700;
    letter-spacing: -0.02em;
    line-height: 1.1;
  }

  .metrics span {
    font-family: var(--mono);
    font-size: 10.5px;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--faint);
  }

  .spark {
    width: 100%;
    height: 44px;
    display: block;
  }

  .spark-cap {
    font-family: var(--mono);
    font-size: 11px;
    color: var(--faint);
    margin: 8px 0 0;
  }

  .contrib {
    padding: 30px 0 34px;
    border-bottom: 1px solid var(--hairline);
  }

  .contrib-head {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    gap: 16px;
    margin-bottom: 16px;
  }

  .contrib-head .micro-label {
    margin: 0;
  }

  .contrib-total {
    font-size: 13px;
    color: var(--muted);
    margin: 0;
  }

  .contrib-total b {
    font-size: 15px;
    font-weight: 700;
    color: var(--ink);
  }

  .contrib-grid {
    display: block;
    width: 100%;
    height: auto;
  }

  .contrib-grid rect {
    transition: fill-opacity 0.15s ease;
  }

  .contrib-grid rect:hover {
    fill-opacity: 1;
  }

  .contrib-month {
    font-family: var(--mono);
    font-size: 10px;
    fill: var(--faint);
  }

  .contrib-foot {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 16px;
    margin-top: 14px;
  }

  .contrib-legend {
    display: flex;
    align-items: center;
    gap: 4px;
    font-family: var(--mono);
    font-size: 10.5px;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--faint);
    margin: 0;
  }

  .contrib-legend i {
    width: 10px;
    height: 10px;
    border-radius: 2px;
  }

  .contrib-legend span:first-child {
    margin-right: 4px;
  }

  .contrib-legend span:last-child {
    margin-left: 4px;
  }

  @media (max-width: 860px) {
    .hero {
      grid-template-columns: 1fr;
      gap: 28px;
      padding: 40px 0 36px;
    }

    .cells {
      grid-template-columns: 1fr;
    }

    .cell {
      border-right: none;
      border-bottom: 1px solid var(--hairline);
      padding-left: 0;
      padding-right: 0;
    }

    .cell:last-child {
      border-bottom: none;
    }
  }
</style>
